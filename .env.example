# ==========================================
# Domain & Traefik Routing Configuration
# ==========================================
DOMAIN=kalobazar.shop
DOMAIN_WWW=true
ACME_EMAIL=admin@kalobazar.shop

# Container Names (Optional - Defaults provided in compose)
CLIENT_CONTAINER_NAME=kalobazar_client
SERVER_CONTAINER_NAME=kalobazar_server
MONGO_CONTAINER_NAME=kalobazar_mongo

# ==========================================
# Application Configuration
# ==========================================
PORT=5000
INTERNAL_API_URL=http://server:5000
NEXT_PUBLIC_SITE_URL=https://kalobazar.shop
NEXT_PUBLIC_API_URL=

# ==========================================
# Database Configuration
# ==========================================
MONGO_DB=kalobazar
MONGODB_URI=mongodb://mongo:27017/kalobazar

# ==========================================
# Admin Security & Authentication
# ==========================================
ADMIN_EMAIL=admin@kalobazar.shop
ADMIN_PASSWORD=YourStrongPasswordHere2026!
ADMIN_JWT_SECRET=replace_with_a_long_random_secret_token_here_2026
ADMIN_TOKEN=admin-secret-token

# ==========================================
# Meta Pixel & Conversions API (CAPI)
# ==========================================
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ==========================================
# Payment Gateway (ZiniPay)
# ==========================================
ZINIPAY_API_KEY=sandbox_test_8f4c9a2e7b31
